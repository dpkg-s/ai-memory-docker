# 先运行 `python template/web-console/make_password.py` 生成哈希，
# 将 AI_MEMORY_WEB_PASSWORD_HASH=... 填入此文件后再启动 Compose。
AI_MEMORY_WEB_BIND=127.0.0.1
AI_MEMORY_WEB_USER=admin
AI_MEMORY_WEB_PASSWORD_HASH=

# 便捷但安全性较低的替代项：明文会出现在容器环境（例如 docker inspect）中。
# 使用明文时填写此项，并保持 AI_MEMORY_WEB_PASSWORD_HASH 为空。
# AI_MEMORY_WEB_PASSWORD=
